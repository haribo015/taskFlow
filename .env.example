# Copy to .env and adapt. Never commit the real .env.
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
RABBITMQ_USER=taskflow
RABBITMQ_PASSWORD=taskflow
# At least 32 characters, shared by all services to verify JWTs
JWT_SECRET=change-me-please-with-a-long-random-string-0123456789
GATEWAY_PORT=8080
